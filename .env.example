# API
VITE_API_URL=https://api.shilingibet.com/api/v1
VITE_API_PROXY_TARGET=https://api.shilingibet.com
VITE_IMAGE_URL=https://api.shilingibet.com
VITE_SOCKET_URL=https://api.shilingibet.com
VITE_TURNSTILE_SITE_KEY=

# MiniPay / Celo USDT deposits (see src/utils/celoMinipay.js)
# Leave unset to keep the MiniPay deposit button disabled.
#
# "mainnet" (default) or "alfajores" for testing.
VITE_CELO_NETWORK=mainnet
# USDT token contract address on Celo — VERIFY on https://celoscan.io
# before setting this. Never guess it.
VITE_USDT_CELO_ADDRESS=
# Your own treasury/receiving wallet address on Celo.
VITE_CELO_DEPOSIT_ADDRESS=
